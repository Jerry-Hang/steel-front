#version 460
#extension GL_EXT_ray_query : require
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba8) uniform image2D outImg;
layout(set = 0, binding = 2, std140) uniform Camera {
  mat4 invVP;
  vec3 origin; float size;
  vec3 sunDir; float pad;
};
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main() {
  ivec2 px = ivec2(gl_GlobalInvocationID.xy);
  if (px.x >= int(size) || px.y >= int(size)) return;
  vec2 ndc = vec2((px.x + 0.5) / size * 2.0 - 1.0, 1.0 - (px.y + 0.5) / size * 2.0);
  vec4 dirW = invVP * vec4(ndc, 1.0, 1.0);
  vec3 d = normalize(dirW.xyz / dirW.w - origin);
  rayQueryEXT q;
  rayQueryInitializeEXT(q, tlas, gl_RayFlagsNoneEXT, 0xFF, origin, 0.001, d, 1000.0);
  while (rayQueryProceedEXT(q)) {}
  vec3 ambient = vec3(0.5, 0.55, 0.6) * 0.5;
  vec3 color;
  uint hitT = rayQueryGetIntersectionTypeEXT(q, 0);
  if (hitT == 0u) {
    color = ambient + vec3(0.45, 0.65, 0.85) * 0.25;
  } else {
    float t = rayQueryGetIntersectionTEXT(q, 0);
    vec3 hp = origin + d * t;
    uint prim = 0u;
    uint inst = 0u;
    uint f = prim / 2u;
    vec3 n = f == 0u ? vec3(-1,0,0) : f == 1u ? vec3(1,0,0) : f == 2u ? vec3(0,-1,0) :
             f == 3u ? vec3(0,1,0) : f == 4u ? vec3(0,0,-1) : vec3(0,0,1);
    vec3 mat = inst == 0u ? vec3(0.35, 0.42, 0.45) : inst == 1u ? vec3(0.55, 0.5, 0.4) :
                inst == 2u ? vec3(0.3, 0.32, 0.36) : vec3(0.22, 0.45, 0.28);
    float ndl = max(dot(n, sunDir), 0.0);
    rayQueryEXT s;
    rayQueryInitializeEXT(s, tlas, gl_RayFlagsNoneEXT, 0xFF, hp + n * 0.01, 0.001, sunDir, 1000.0);
    while (rayQueryProceedEXT(s)) {}
    float vis = rayQueryGetIntersectionTypeEXT(s, 0) == 0u ? 1.0 : 0.15;
    color = mat * (ambient + vec3(1.0, 0.95, 0.85) * 1.5 * ndl * vis);
  }
  imageStore(outImg, px, vec4(color, 1.0));
}
