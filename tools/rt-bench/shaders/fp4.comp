#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer OutB { uint o[]; };
void main() {
    uint g = gl_GlobalInvocationID.x;
    uint acc = (g & 0x7u) | 0x88u;
    for (uint i = 0; i < 4096; i++) {
        acc = ((acc << 2) ^ (acc >> 1) + 0xDu) & 0xFFu;
    }
    o[g] = acc;
}
